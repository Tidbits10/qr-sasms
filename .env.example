# ── Database ────────────────────────────────────────────────
# Matches the docker-compose.yml Postgres service below.
DATABASE_URL="postgresql://qrsasms:qrsasms@localhost:5432/qrsasms?schema=public"

# ── Auth ────────────────────────────────────────────────────
# Any long random string. Used to sign the httpOnly session cookie (JWT).
# Generate one with: openssl rand -base64 48
AUTH_SECRET="change-this-to-a-long-random-string"

# ── Outgoing email (SMTP via Nodemailer) ───────────────────────
# Leave these blank to run in SIMULATED mode: emails are recorded in the
# in-app "Email Outbox" (admin dashboard) and as Notifications, but no
# real email is sent. Fill them in to send real email.
#
# Example for Gmail: create a 16-character "App Password" at
# https://myaccount.google.com/apppasswords (requires 2FA enabled) and use:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM="QR-SASMS <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="QR-SASMS <no-reply@pup-sanpedro.edu.ph>"

# Optional: enables automated Nodemailer reminders through an external scheduler.
# Schedule POST /api/cron/reminders hourly using Authorization: Bearer <this value>.
CRON_SECRET=

# ── File uploads ────────────────────────────────────────────
# Absolute or project-relative directory where uploaded files
# (OR receipts, event documents, complaint attachments, downloadable
# forms) are stored on disk. Served publicly under /uploads/*.
UPLOAD_DIR="./public/uploads"
